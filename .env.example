# Credenciales exclusivas para el simulador local. Nunca reutilizar credenciales de Altán.
ALTAN_LOCAL_CONSUMER_KEY=local-crm
ALTAN_LOCAL_CONSUMER_SECRET=local-secret-change-me
ALTAN_LOCAL_ACCESS_TOKEN=local-altan-access-token

# Credenciales exclusivas para el simulador local de Conecty.
CONECTY_LOCAL_DOCUMENT=local-document
CONECTY_LOCAL_API_KEY=local-conecty-key
CONECTY_LOCAL_TOKEN=local-conecty-token

# memory for disposable tests; dynamodb to survive restarts and share state.
MOCK_STORAGE=dynamodb
DYNAMODB_TABLE=altan-local-apis
DYNAMODB_REGION=us-east-2
# Use a separate namespace locally; Amplify master uses default.
MOCK_NAMESPACE=local
# Local development only. Amplify uses its SSR Compute role.
AWS_PROFILE=altan-local-apis
